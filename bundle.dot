// This repository packages a single specialist assistant that installs, updates, and manages Windows software through the winget package manager.
digraph winget_ops {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Windows Software Manager (winget-ops) v1.0.0\nA ready-to-use assistant that installs and updates Windows apps for you"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="a3ae5525df4615a07cb457f9f7b7921d2e047b7aed0f4b6c44e9a4eb61aac660"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_winget_ops [label="The Package Itself\nWindows Software Manager v1.0.0\n0 tools · 0 agents\n~178 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="What This Package Adds To Your Assistant"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_winget_ops_behavior [label="Windows Software Skills\nTurns on winget know-how\n1 ctx\n~526 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_agents {
        label="The Specialist Who Does The Work"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        agt_winget_ops [label="Windows Software Specialist\nHandles install, update, remove\n~762 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Written Instructions The Specialist Follows"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        ctx_delegation_instructions_md [label="When To Call The Specialist\ndelegation-instructions.md\n~446 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend — What The Colors Mean"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="the package itself", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="skills it turns on", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="specialist helper", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="add-on capability", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="AI service used", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="written instructions", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="works on its own", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experimental piece", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="borrowed, adds cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="borrowed, no cost", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="\"tok\" = tokens, the units of reading effort the AI spends\nToken estimates: ~4 chars/token\nSolid border = included here (counted)\nDashed + red = borrowed from elsewhere, hidden cost (not counted)\nDashed + muted = borrowed from elsewhere, no cost\nExcludes: sub-session costs, runtime-dynamic", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]


    root_winget_ops -> beh_winget_ops_behavior [label="turns on"]
    beh_winget_ops_behavior -> ctx_delegation_instructions_md [style=dotted, color=purple]
}